{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GramPanchayatTank",
  "type": "object",
  "required": [
    "tank_id",
    "panchayat_name",
    "district",
    "taluk",
    "surface_area_hectares",
    "cooperative_society",
    "contact_person",
    "coordinates"
  ],
  "properties": {
    "tank_id": {
      "type": "string",
      "description": "Unique identifier, e.g., KA-MND-0412"
    },
    "name_english": {
      "type": "string"
    },
    "name_kannada": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "taluk": {
      "type": "string"
    },
    "panchayat_name": {
      "type": "string"
    },
    "surface_area_hectares": {
      "type": "number",
      "minimum": 0.5
    },
    "average_depth_meters": {
      "type": "number"
    },
    "stocked_fish_species": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_biomass_kg": {
      "type": "number"
    },
    "economic_value_inr": {
      "type": "number"
    },
    "cooperative_society": {
      "type": "string"
    },
    "contact_person": {
      "type": "object",
      "required": [
        "name",
        "phone_number"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "President",
            "Secretary",
            "Panchayat Development Officer (PDO)"
          ]
        },
        "phone_number": {
          "type": "string",
          "pattern": "^\\+91[0-9]{10}$"
        },
        "preferred_language": {
          "type": "string",
          "enum": [
            "kn",
            "en"
          ]
        }
      }
    },
    "coordinates": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Polygon"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      }
    }
  }
}