# Satellite Ingestion API (Copernicus / GEE)
COPERNICUS_CLIENT_ID=your_copernicus_id
COPERNICUS_CLIENT_SECRET=your_copernicus_secret
GEE_SERVICE_ACCOUNT_JSON=./config/gee_credentials.json

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algal_watch_db
REDIS_URL=redis://localhost:6379/0

# Alerting Gateways (SMS & WhatsApp in Kannada / English)
SMS_GATEWAY_PROVIDER=gupshup
GUPSHUP_API_KEY=your_gupshup_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
SENDER_PHONE=+918000000000

# Operational Configuration
DEFAULT_STATE=Karnataka
CLOUD_COVERAGE_THRESHOLD=25.0
DO_CRITICAL_THRESHOLD_MG_L=4.0
